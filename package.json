{
  "name": "language-learning-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @language/contracts build && pnpm --filter @language/domain build && pnpm --filter @language/language-fi build && pnpm --filter @language/database build",
    "dev": "turbo dev",
    "dev:setup": "pnpm db:start && pnpm db:migrate:deploy && pnpm db:seed",
    "dev:full": "pnpm dev:setup && pnpm dev",
    "build": "turbo build",
    "lint": "turbo lint && eslint e2e playwright.config.ts",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "pnpm --filter @language/api test:integration",
    "e2e": "playwright test",
    "e2e:local": "pnpm dev:setup && pnpm build && pnpm e2e",
    "content:validate": "pnpm --filter @language/database content:validate",
    "content:generate:paradigms": "tsx scripts/generate-finnish-paradigms.ts",
    "content:audit:mvp": "pnpm --filter @language/database content:audit:mvp",
    "publication:validate": "pnpm --filter @language/database publication:validate",
    "api:smoke:production": "node scripts/api-production-smoke.mjs",
    "db:validate": "pnpm --filter @language/database db:validate",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "db:migrate:dev": "pnpm --filter @language/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @language/database db:migrate:deploy",
    "db:seed": "pnpm --filter @language/database db:seed",
    "db:studio": "pnpm --filter @language/database db:studio",
    "user:set-role": "pnpm --filter @language/database user:set-role",
    "audio:generate": "pnpm --filter @language/database build && pnpm --filter @language/api audio:generate",
    "audio:generate:words": "pnpm --filter @language/database build && pnpm --filter @language/api audio:generate:words",
    "audio:generate:sentences": "pnpm --filter @language/database build && pnpm --filter @language/api audio:generate:sentences",
    "audio:generate:texts": "pnpm --filter @language/database build && pnpm --filter @language/api audio:generate:texts",
    "audio:bundle:export": "pnpm --filter @language/api audio:bundle:export",
    "audio:bundle:import": "pnpm --filter @language/api audio:bundle:import",
    "audio:sync:vps": "sh scripts/audio/sync-to-vps.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
