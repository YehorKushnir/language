# Public hostname. Do not include a scheme or path.
APP_DOMAIN=morpho-learning.duckdns.org

# Immutable images produced by GitHub Actions.
IMAGE_REPO=ghcr.io/yehorkushnir/language
IMAGE_TAG=CHANGE_ME_GIT_COMMIT_SHA

# Existing Docker network of the shared edge Caddy on the VPS.
EDGE_NETWORK=framed_default

# Generate both values independently with: openssl rand -hex 32
# POSTGRES_PASSWORD must remain URL-safe because Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_64_HEX_CHARACTERS
BETTER_AUTH_SECRET=CHANGE_ME_ANOTHER_64_HEX_CHARACTERS

# OAuth credentials for the public production origin.
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Password reset delivery is mandatory when real people can register.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Morpho Learning <no-reply@example.com>

# Keep empty until prepared media is hosted on a separate HTTPS origin.
MEDIA_BASE_URL=

# Google Cloud Text-to-Speech and persistent local VPS audio cache.
TTS_PROVIDER=google
GOOGLE_TTS_AUTH_MODE=adc
GOOGLE_TTS_PROJECT_ID=CHANGE_ME_GOOGLE_PROJECT
GOOGLE_TTS_VOICE=fi-FI-Chirp3-HD-Aoede
GOOGLE_TTS_LANGUAGE=fi-FI
GOOGLE_TTS_CHIRP3_MIN_INTERVAL_MS=310
GOOGLE_TTS_CREDENTIALS_FILE=/secure/path/google-tts-service-account.json
AUDIO_NORMAL_SPEAKING_RATE=1
AUDIO_GENERATION_VERSION=v1
AUDIO_GENERATION_CONCURRENCY=4
AUDIO_STORAGE_PROVIDER=local
AUDIO_LOCAL_DIRECTORY=/app/.data
AUDIO_STORAGE_BUCKET=
AUDIO_STORAGE_ENDPOINT=
AUDIO_STORAGE_REGION=auto
AUDIO_STORAGE_ACCESS_KEY=
AUDIO_STORAGE_SECRET_KEY=
AUDIO_PUBLIC_URL=
