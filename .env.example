NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://language:language@localhost:5432/language
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=development-only-change-me-32-characters
# SMTP_HOST is optional in development: reset links are written to the local API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Language Learning <no-reply@example.com>
VITE_API_URL=/api/v1
MEDIA_BASE_URL=
TTS_PROVIDER=google
GOOGLE_TTS_AUTH_MODE=adc
GOOGLE_TTS_PROJECT_ID=
GOOGLE_TTS_VOICE=fi-FI-Chirp3-HD-Aoede
GOOGLE_TTS_LANGUAGE=fi-FI
GOOGLE_TTS_CHIRP3_MIN_INTERVAL_MS=310
# Standard Google ADC credential file; never expose it to Vite/frontend vars.
GOOGLE_APPLICATION_CREDENTIALS=
AUDIO_NORMAL_SPEAKING_RATE=1
AUDIO_GENERATION_VERSION=v1
AUDIO_GENERATION_CONCURRENCY=4
AUDIO_STORAGE_PROVIDER=local
AUDIO_LOCAL_DIRECTORY=.data
AUDIO_STORAGE_BUCKET=
AUDIO_STORAGE_ENDPOINT=
AUDIO_STORAGE_REGION=auto
AUDIO_STORAGE_ACCESS_KEY=
AUDIO_STORAGE_SECRET_KEY=
AUDIO_PUBLIC_URL=
