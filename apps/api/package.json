{
  "name": "@language/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_DATABASE_INTEGRATION=true vitest run src/audio/audio-database.integration.spec.ts",
    "test:watch": "vitest",
    "audio:generate": "tsx src/audio/generate-audio.ts",
    "audio:generate:words": "tsx src/audio/generate-audio.ts --scope=words",
    "audio:generate:sentences": "tsx src/audio/generate-audio.ts --scope=sentences",
    "audio:generate:texts": "tsx src/audio/generate-audio.ts --scope=texts",
    "audio:bundle:export": "tsx src/audio/export-audio-bundle.ts",
    "audio:bundle:import": "tsx src/audio/import-audio-bundle.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@better-auth/prisma-adapter": "1.7.1",
    "@google-cloud/text-to-speech": "^7.0.0",
    "@language/contracts": "workspace:*",
    "@language/database": "workspace:*",
    "@language/domain": "workspace:*",
    "@language/language-fi": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "better-auth": "1.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
